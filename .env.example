# Vercel runtime settings. Keep secret values in Vercel project environment variables.
DATA_BACKEND=supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
ADMIN_REG=replace-with-admin-registration-number
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose-a-new-strong-admin-password

# Local-only settings for importing the current Netlify Blobs database.
# Put real values in .env.local (ignored by Git), never in this file.
NETLIFY_SITE_ID=replace-with-netlify-site-id
NETLIFY_AUTH_TOKEN=replace-with-netlify-personal-access-token
CONFIRM_MIGRATION=CampusLoop
